<?xml version="1.0" encoding="utf-8"?>
<!--
    Privileged permission whitelist for the Google hotword enrollment blob
    shipped as HotwordEnrollmentOKGoogleExTL3210 (a9y18qlte-vendor.mk).

    Android 10 hard-enforces this whitelist: a privileged app holding a
    signature|privileged permission with no entry here throws
    IllegalStateException out of PermissionManagerService.systemReady(), which
    kills system_server and bootloops the device.

    Stock ships an equivalent file; it was not captured by extract-files.sh.
-->
<permissions>
    <privapp-permissions package="com.android.hotwordenrollment.okgoogle">
        <permission name="android.permission.MANAGE_VOICE_KEYPHRASES"/>
    </privapp-permissions>
</permissions>
