# Audio
ro.bluetooth.a2dp_offload.supported=false
persist.bluetooth.a2dp_offload.disabled=true
vendor.audio.feature.a2dp_offload.enable=false

# Bluetooth
vendor.bluetooth.soc=cherokee
vendor.qcom.bluetooth.soc=cherokee
#ro.bluetooth.library_name=libbluetooth_qti.so
persist.vendor.btstack.enable.splita2dp=true
persist.vendor.btstack.a2dp_offload_cap=sbc-aptx-aptxhd-aac

# CNE
persist.vendor.cne.feature=1

# Netflix custom property
ro.netflix.bsp_rev=Q660-13149-1

# Qualcomm
ro.vendor.qti.va_aosp.support=1
vendor.sec.rild.libpath=/vendor/lib64/libsec-ril.so
vendor.sec.rild.libpath2=/vendor/lib64/libsec-ril-dsds.so

# VoLTE / VT
#
# isVolteEnabledByPlatform() needs config_device_volte_available (true in our
# framework overlay) AND KEY_CARRIER_VOLTE_AVAILABLE_BOOL from CarrierConfig.
# AOSP ships no 404xx entry so that key defaulted false; overlay vendor.xml now
# sets it in the default carrier_config block.
#
# The overrides below short-circuit that check in ImsManager
# (PROPERTY_DBG_VOLTE_AVAIL_OVERRIDE). Left off deliberately: on A10/BSNL, whose
# network reported no VoPS, forcing them routed calls to ImsPhoneCallTracker
# while the Samsung stack was unregistered and calls stuck in DIALING with no
# way to hang up. Only set these once dumpsys secims shows Registered: true.
#persist.dbg.volte_avail_ovr=1
#persist.dbg.vt_avail_ovr=1

# Debugging
# ro.adb.secure is left to WITH_ADB_INSECURE in lineage_a9y18qlte.mk; setting it
# here too makes post_process_props fail on the duplicate.
persist.service.adb.enable=1
persist.sys.usb.config=adb
