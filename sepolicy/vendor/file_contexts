# Samsung vendor binaries with no upstream file_contexts entry.
/vendor/bin/vendor\.samsung\.hardware\.security\.proca@2\.0-service u:object_r:sec_proca_exec:s0
/vendor/bin/vendor\.samsung\.hardware\.security\.wsm@1\.0-service   u:object_r:sec_wsm_exec:s0
/vendor/bin/hw/vendor\.trustonic\.tee@1\.0-service                  u:object_r:tee_hal_exec:s0
/vendor/bin/hw/vendor\.trustonic\.teeregistry@1\.0-service          u:object_r:teeregistry_hal_exec:s0
/vendor/bin/factory\.adsp                                           u:object_r:factory_adsp_exec:s0

# qcom labels every other init.*.sh as qti_init_shell_exec but omits this one,
# which is why it showed up as "qti_init_shell -> vendor_file : entrypoint".
/vendor/bin/init\.qti\.can\.sh                                      u:object_r:qti_init_shell_exec:s0
/vendor/bin/init\.qcom\.crashdata\.sh                                 u:object_r:qti_init_shell_exec:s0

# Oneshot services - see samsung_vendor_daemons.te.
/vendor/bin/hw/macloader                                            u:object_r:macloader_exec:s0
/vendor/bin/secril_config_svc                                       u:object_r:secril_config_exec:s0
/vendor/bin/energy-awareness                                        u:object_r:energyawareness_exec:s0
/vendor/bin/init\.qti\.qseecomd\.sh                                 u:object_r:qseecomd_sh_exec:s0
# Labelled here rather than by qcom: LineageOS 19.1's sepolicy-legacy-um does not.
/vendor/bin/init\.qcom\.sensors\.sh                                 u:object_r:init-qcom-sensors-sh_exec:s0

# See rild.te.
/dev/socket/qosd                                                    u:object_r:qosd_socket:s0
/data/vendor/secradio(/.*)?                                         u:object_r:rild_secradio_data_file:s0

# Samsung fingerprint sensor node. See samsung_devices.te.
/dev/esfp0                                                          u:object_r:sec_fingerprint_device:s0

# Graphics allocator passthrough HAL.
/vendor/lib64/hw/gralloc\.sdm660\.so                                u:object_r:same_process_hal_file:s0
/vendor/lib/hw/gralloc\.sdm660\.so                                  u:object_r:same_process_hal_file:s0

# Samsung PTA character device.

# Block devices.
/dev/block/sda1                                                     u:object_r:modem_efs_block_device:s0
/dev/block/sda2                                                     u:object_r:modem_efs_block_device:s0
/dev/block/sda3                                                     u:object_r:modem_efs_block_device:s0
# fsg lives on a different disk (sdd), not sda.
/dev/block/sdd3                                                     u:object_r:modem_efs_block_device:s0

# NXP PN547 NFC controller node.
/dev/pn547                                                          u:object_r:nfc_device:s0

# macloader caches the Wi-Fi version it reads back from the chip.
/data/vendor/conn(/.*)?                                             u:object_r:wifi_vendor_data_file:s0
/dev/block/sda8                                                     u:object_r:misc_block_device:s0
/dev/block/sda29                                                    u:object_r:userdata_block_device:s0
/dev/block/sda25                                                    u:object_r:cache_block_device:s0
/dev/block/sda4                                                     u:object_r:ssd_block_device:s0

# Battery calibration data.
/efs/Battery(/.*)?                                                  u:object_r:battery_efs_file:s0
/mnt/vendor/efs/Battery(/.*)?                                       u:object_r:battery_efs_file:s0

# Factory calibration data, read by the health HAL and rild.
/efs/FactoryApp(/.*)?                                               u:object_r:app_efs_file:s0
/mnt/vendor/efs/FactoryApp(/.*)?                                    u:object_r:app_efs_file:s0

# IMEI data, read by rild.
/efs/imei(/.*)?                                                     u:object_r:imei_efs_file:s0
/mnt/vendor/efs/imei(/.*)?                                          u:object_r:imei_efs_file:s0

