# Samsung vendor binaries with no upstream file_contexts entry. Unlabelled,
# they keep the generic vendor_file type, no type_transition fires, and init
# runs them in its own domain - which enforcing then refuses to exec.
/vendor/bin/vendor\.samsung\.hardware\.security\.proca@2\.0-service u:object_r:sec_proca_exec:s0
/vendor/bin/vendor\.samsung\.hardware\.security\.wsm@1\.0-service   u:object_r:sec_wsm_exec:s0
/vendor/bin/hw/vendor\.trustonic\.tee@1\.0-service                  u:object_r:tee_hal_exec:s0
/vendor/bin/hw/vendor\.trustonic\.teeregistry@1\.0-service          u:object_r:teeregistry_hal_exec:s0
/vendor/bin/factory\.adsp                                           u:object_r:factory_adsp_exec:s0

# See rild.te. Both of these otherwise fall back to generic types that rild is
# not permitted to touch.
/dev/socket/qosd                                                    u:object_r:qosd_socket:s0
/data/vendor/secradio(/.*)?                                         u:object_r:rild_secradio_data_file:s0

# Samsung fingerprint sensor node. See samsung_devices.te.
/dev/esfp0                                                          u:object_r:sec_fingerprint_device:s0

# Battery calibration data. Matches the xattr the stock firmware already wrote,
# and covers the files inside the directory, which were never labelled.
/efs/Battery(/.*)?                                                  u:object_r:battery_efs_file:s0
/mnt/vendor/efs/Battery(/.*)?                                       u:object_r:battery_efs_file:s0

# Factory calibration data, read by the health HAL. Kept next to the
# app_efs_file declaration in samsung_hals.te.
/efs/FactoryApp(/.*)?                                               u:object_r:app_efs_file:s0
/mnt/vendor/efs/FactoryApp(/.*)?                                    u:object_r:app_efs_file:s0

# Fingerprint calibration and template data. See samsung_hals.te.
/data/vendor/biometrics(/.*)?                                       u:object_r:sec_biometrics_data_file:s0
