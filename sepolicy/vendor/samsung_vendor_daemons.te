# Domains for the Samsung /vendor binaries that AOSP has no equivalent for.

# Samsung PROCA (periodic process/kernel integrity attestation).
type sec_proca, domain;
type sec_proca_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(sec_proca)

# Samsung WSM (secure memory manager backing the TEE).
type sec_wsm, domain;
type sec_wsm_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(sec_wsm)

# Trustonic Kinibi TEE driver service and its registry.
type tee_hal, domain;
type tee_hal_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(tee_hal)
hal_server_domain(tee_hal, hal_keymaster)

type teeregistry_hal, domain;
type teeregistry_hal_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(teeregistry_hal)

# ADSP firmware loader.
type factory_adsp, domain;
type factory_adsp_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(factory_adsp)

# Oneshot services.

# Samsung Wi-Fi MAC address loader.
type macloader, domain;
type macloader_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(macloader)

# Samsung RIL configuration service.
type secril_config, domain;
type secril_config_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(secril_config)

# Qualcomm energy awareness daemon: declared by qcom, not here.

# Shell wrapper init runs to bring up qseecomd.
type qseecomd_sh, domain;
type qseecomd_sh_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(qseecomd_sh)
allow qseecomd_sh vendor_shell_exec:file rx_file_perms;
allow qseecomd_sh vendor_toolbox_exec:file rx_file_perms;

# Samsung's qseecomd announces readiness with vendor.sys.qseecomd.enable, which
# qcom's property_contexts does not name.
vendor_internal_prop(vendor_qseecomd_prop)
set_prop(tee, vendor_qseecomd_prop)

vendor_internal_prop(samsung_bluetooth_prop)
set_prop(hal_bluetooth_default, samsung_bluetooth_prop)

vendor_internal_prop(samsung_ril_prop)
set_prop(rild, samsung_ril_prop)


# ############################################################################# Ru.

# PROCA drives the integrity check through the TEE.
allow sec_proca tee_device:chr_file rw_file_perms;
allow sec_proca ion_device:chr_file rw_file_perms;
hwbinder_use(sec_proca)

# WSM and the TEE registry both publish an HIDL service.
hwbinder_use(sec_wsm)
hwbinder_use(teeregistry_hal)
hwbinder_use(tee_hal)
allow tee_hal tee_device:chr_file rw_file_perms;
allow teeregistry_hal tee_device:chr_file rw_file_perms;

# The ADSP loader reads sensor calibration out of /persist and opens a local
# socket pair to talk to the DSP.
r_dir_file(factory_adsp, persist_sensors_file)
allow factory_adsp mnt_vendor_file:dir getattr;
allow factory_adsp sysfs:file r_file_perms;
allow factory_adsp self:socket { create read write };
allow factory_adsp self:netlink_socket { create bind read write };
allow factory_adsp self:tcp_socket { create bind listen accept read write };
allow factory_adsp node:tcp_socket node_bind;
