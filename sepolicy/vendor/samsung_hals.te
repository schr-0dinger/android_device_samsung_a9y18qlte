# Rules for the stock HAL domains once the Samsung binaries actually reach
# them. While these services ran as init they inherited init's privileges and
# none of this was needed; every rule below comes from a denial observed after
# the type_transition started working.

# --- health -----------------------------------------------------------------
# Battery nodes live under the sm5705 charger rather than a stock path, and the
# calibration data sits in /efs.
#
# /efs/Battery already carries a battery_efs_file xattr written by the stock
# Samsung firmware, but no policy in this tree ever declared that type. The
# kernel reports an xattr naming an unknown type as "unlabeled", which is why
# the denial pointed at unlabeled while ls -Z showed battery_efs_file. Declaring
# it makes the existing label valid rather than relabelling the partition.
type battery_efs_file, file_type, data_file_type;

# Factory calibration data. Declared here rather than in plat_private because
# hal_health_default is a vendor domain and cannot see plat_private types.
type app_efs_file, file_type, data_file_type;

# IMEI data, read by rild. Same reason it lives here: rild is a vendor domain.
type imei_efs_file, file_type, data_file_type;
allow hal_health_default sysfs_batteryinfo:dir search;
allow hal_health_default sysfs_batteryinfo:file rw_file_perms;
r_dir_file(hal_health_default, app_efs_file)
allow hal_health_default app_efs_file:file { write setattr };
r_dir_file(hal_health_default, battery_efs_file)
allow hal_health_default battery_efs_file:file { write setattr };

# --- camera -----------------------------------------------------------------
# Flash, firmware version and the v4l2 device names are all read out of sysfs,
# and the provider writes the kernel's memory-boost knob while streaming.
r_dir_file(hal_camera_default, sysfs_camera)
allow hal_camera_default sysfs_camera:file rw_file_perms;
binder_call(hal_camera_default, surfaceflinger)
# And the return direction: surfaceflinger calls into the provider too, which
# binder_call() above does not cover - it only grants the callee transfer, not
# call.
binder_call(surfaceflinger, hal_camera_default)

# The provider writes the kernel memory-boost knob while streaming. It lives
# under /sys/kernel, not /sys/devices, so the sysfs_camera genfscon does not
# reach it and it needs a type of its own.
type sysfs_vmscan, sysfs_type, fs_type;
allow hal_camera_default sysfs_vmscan:dir search;
allow hal_camera_default sysfs_vmscan:file rw_file_perms;

# --- usb --------------------------------------------------------------------
r_dir_file(hal_usb_default, sysfs_usb_c)

# --- power ------------------------------------------------------------------
allow hal_power_default sysfs_batteryinfo:dir search;

# --- fingerprint ------------------------------------------------------------
# Calibration and template data. Generic vendor_data_file otherwise, which the
# HAL may not write.
type sec_biometrics_data_file, file_type, data_file_type;
allow hal_fingerprint_default sec_biometrics_data_file:dir create_dir_perms;
allow hal_fingerprint_default sec_biometrics_data_file:file create_file_perms;
