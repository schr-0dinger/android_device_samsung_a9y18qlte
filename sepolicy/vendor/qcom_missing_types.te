# Types QASSA's qcom sepolicy declared and LineageOS 19.1's does not.

# Camera sysfs nodes: flash, firmware version and the v4l2 device names.
type sysfs_camera, sysfs_type, fs_type;

# Qualcomm mpctl / perf tunables under /sys/devices/system/cpu.
type sysfs_mpctl, sysfs_type, fs_type;

# USB Type-C port state, read by the USB HAL.
type sysfs_usb_c, sysfs_type, fs_type;

# Samsung's SSD block device, labelled in sepolicy/vendor/file_contexts.
type ssd_block_device, dev_type;

# Sensor calibration under /persist/sensors.
type persist_sensors_file, file_type, vendor_persist_type;

# The qcom sensors init script.
type init-qcom-sensors-sh, domain;
type init-qcom-sensors-sh_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(init-qcom-sensors-sh)
allow init-qcom-sensors-sh vendor_shell_exec:file rx_file_perms;
allow init-qcom-sensors-sh vendor_toolbox_exec:file rx_file_perms;
