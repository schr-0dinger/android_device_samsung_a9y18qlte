# This is a system-as-root device, so the build places file_contexts.bin in the
# root of the system image.
/file_contexts\.bin                u:object_r:rootfs:s0

/bt_firmware(/.*)?                 u:object_r:bt_firmware_file:s0
/firmware(/.*)?                    u:object_r:firmware_file:s0
# /dsp is labelled upstream as adsprpcd_file
# (device/qcom/sepolicy-legacy-um/legacy/vendor/common/file_contexts:619), which
# is the specific type the ADSP RPC daemon expects.
/omr(/.*)?                         u:object_r:vendor_file:s0
/persist(/.*)?                     u:object_r:persist_file:s0
# /efs/wifi labels moved to sepolicy/vendor/file_contexts with the type.
/vendor/bin/hw/vendor\.samsung\.hardware\.wifi@2\.0-service u:object_r:hal_wifi_default_exec:s0
/vendor/bin/hw/vendor\.samsung\.hardware\.light@3\.0-service u:object_r:hal_light_default_exec:s0
/vendor/bin/hw/android\.hardware\.gatekeeper@1\.0-service u:object_r:hal_gatekeeper_default_exec:s0
/vendor/bin/hw/android\.hardware\.keymaster@3\.0-service u:object_r:hal_keymaster_default_exec:s0
/vendor/bin/hw/vendor\.samsung\.hardware\.biometrics\.fingerprint@3\.0-service u:object_r:hal_fingerprint_default_exec:s0

# Samsung ships these HALs under names the stock file_contexts regexes do not
# match - the AOSP patterns expect android.hardware.<iface>@<ver>-service, not a
# vendor prefix or a .samsung/.wahoo suffix.
/vendor/bin/hw/vendor\.samsung\.hardware\.camera\.provider@3\.0-service u:object_r:hal_camera_default_exec:s0
/vendor/bin/hw/nxp\.android\.hardware\.nfc@1\.1-service u:object_r:hal_nfc_default_exec:s0
/vendor/bin/hw/android\.hardware\.usb@1\.1-service\.wahoo u:object_r:hal_usb_default_exec:s0
/vendor/bin/hw/android\.hardware\.health@2\.0-service\.samsung u:object_r:hal_health_default_exec:s0
/vendor/bin/hw/vendor\.samsung\.hardware\.vibrator@2\.0-service u:object_r:hal_vibrator_default_exec:s0
/vendor/bin/hw/vendor\.samsung\.hardware\.miscpower@2\.0-service u:object_r:hal_power_default_exec:s0

# Samsung daemons on the system partition. See samsung_system_daemons.te.
/system/bin/imsd          u:object_r:samsung_imsd_exec:s0
/system/bin/smdexe        u:object_r:smdexe_exec:s0
/system/bin/connfwexe     u:object_r:connfwexe_exec:s0
/system/bin/multiclientd  u:object_r:multiclientd_exec:s0

# Block devices, names from /dev/block/by-name.
/dev/block/sda12          u:object_r:frp_block_device:s0
/dev/block/sda28          u:object_r:sec_debug_block_device:s0

# imsd control socket.
/dev/socket/imsd          u:object_r:imsd_socket:s0

# IMS call-recording log, written by the Samsung IMS app and imsd.
/data/log/imscr(/.*)?     u:object_r:ims_log_data_file:s0

# connfwexe packet-capture control socket. See private/platform_fixes.te.
/data/\.tcpdump_socket    u:object_r:tcpdump_socket_file:s0
